# Configuración del LLM (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo seleccionado
MODEL_NAME=stepfun/step-3.5-flash:free

MODEL_SUPERVISOR=stepfun/step-3.5-flash:free
MODEL_BILLING=stepfun/step-3.5-flash:free
MODEL_TECH=stepfun/step-3.5-flash:free
MODEL_SALES=stepfun/step-3.5-flash:free
MODEL_QA=stepfun/step-3.5-flash:free
MODEL_RAG=liquid/lfm-2.5-1.2b-thinking:free

# Configuración del servidor
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Base de Datos (PostgreSQL)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname

# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333

# Redis (Background Jobs)
REDIS_URL=redis://localhost:6379/0

# Canales
TELEGRAM_ENABLED=false
TELEGRAM_MTPROTO_ENABLED=false
TELEGRAM_MTPROTO_KILL_SWITCH=false
TELEGRAM_MTPROTO_ALLOWED_VENDORS=""
TELEGRAM_MTPROTO_API_ID=your_telegram_api_id
TELEGRAM_MTPROTO_API_HASH=your_telegram_api_hash
# TELEGRAM_PUBLIC_BASE_URL=https://your-domain.com

# API Settings
PROJECT_NAME="Agent Ecosystem API"
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Security (Rate Limits)
RATE_LIMIT_HEALTH="10/minute"
RATE_LIMIT_READ_PRODUCTS="60/minute"
RATE_LIMIT_WRITE_PRODUCTS="10/minute"
RATE_LIMIT_UPDATE_PRODUCTS="20/minute"
RATE_LIMIT_DELETE_PRODUCTS="5/minute"

# Mercado Pago 
MP_WEBHOOK_URL=https://your-domain.com/api/v1/billing/webhooks/mp
MP_WEBHOOK_SECRET=your_mp_webhook_secret
MP_ACCESS_TOKEN=your_mp_access_token

# Security
SECRET_KEY=your_secret_key_here
CSRF_SECRET_KEY=your_csrf_secret_key_here
